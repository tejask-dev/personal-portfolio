{
  "name": "personal-portfolio",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node --experimental-strip-types scripts/prerender.ts",
    "build:github": "vite build --base=/personal-portfolio/ && node --experimental-strip-types scripts/prerender.ts",
    "preview": "vite preview",
    "check": "tsc",
    "deploy": "npm run build:github && gh-pages -d docs --include-dotfiles",
    "test": "node --experimental-strip-types --test tests/open-water-controller.test.ts tests/open-water-race.test.ts tests/open-water-v3.test.ts",
    "test:browser": "node tests/open-water-v3-browser.mjs",
    "test:static": "node --experimental-strip-types tests/open-water-static.mjs",
    "test:touch": "node tests/open-water-touch.mjs",
    "test:touch-layout": "node tests/open-water-touch-layout.mjs",
    "test:cross-browser": "node tests/open-water-cross-browser.mjs",
    "test:gameplay": "node --experimental-strip-types tests/open-water-gameplay.mjs",
    "test:v2:browser": "node tests/open-water-browser.mjs",
    "test:v3:browser": "node tests/open-water-v3-browser.mjs",
    "test:v3:performance": "node tests/open-water-v3-performance.mjs",
    "test:v4": "node --experimental-strip-types --test tests/open-water-v4-expedition.test.ts tests/open-water-v4-failure.test.ts tests/open-water-v4-games.test.ts tests/open-water-v4-regions.test.ts tests/portfolio-v4.test.ts && node tests/open-water-v4-regions-render.mjs && node tests/open-water-v4-companions.mjs && node tests/open-water-v4-character-reentry.mjs",
    "test:v4:browser": "node tests/open-water-v4-browser.mjs",
    "test:v4:performance": "node tests/open-water-v4-performance.mjs",
    "test:v4:content": "node --experimental-strip-types tests/portfolio-v4-public-output.mjs --out-dir docs && node --test tests/portfolio-v4-contact.mjs",
    "test:v4:assets": "node scripts/check-open-water-v4-assets.mjs design/open-water-v4/implementation-qa/art",
    "test:scroll": "node tests/open-water-scroll-dive.mjs",
    "test:swimming": "node tests/open-water-fish-swimming.mjs && node tests/open-water-fish-shader.mjs",
    "test:swimming:browser": "node tests/open-water-v4-swimming-browser.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^8.18.0",
    "@vercel/analytics": "2.0.1",
    "lucide-react": "^0.453.0",
    "motion": "^12.23.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.167.1",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@types/node": "^24.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.167.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "gh-pages": "^6.3.0",
    "playwright": "1.63.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "5.6.3",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
